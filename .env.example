BASE_URL=https://halloween2026.douglasneuroinformatics.ca
PORT=3000
DATA_DIR=/data
CONTENT_DIR=/app/content
# Set to 1 behind Caddy so the client IP comes from X-Forwarded-For.
TRUST_PROXY=1

# Wall-clock times in TZ_CONTEST (default America/Montreal), format YYYY-MM-DDTHH:MM
TZ_CONTEST=America/Montreal
OPEN_AT=2026-10-30T08:00
SUBMIT_CLOSE_AT=2026-10-30T14:00
VOTE_CLOSE_AT=2026-10-30T16:00
SESSION_END_AT=2026-10-30T23:59

ALLOWED_DOMAINS=mcgill.ca,mail.mcgill.ca,douglas.mcgill.ca,ssss.gouv.qc.ca
ADMIN_EMAILS=
# Non-admins who may log in before the contest opens (deliverability testing).
PREVIEW_EMAILS=
IP_SEND_LIMIT_PER_HOUR=100

# smtp (Scaleway TEM) or console (prints emails to stdout, for local dev)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Halloween DRC <noreply@mail.douglasneuroinformatics.ca>"

# openssl rand -base64 48
SESSION_SECRET=
